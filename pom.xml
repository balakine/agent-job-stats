<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2236.v12dd4c483242</version>
    <relativePath/>
  </parent>

  <groupId>com.varjo.jenkins</groupId>
  <artifactId>agent-events</artifactId>
  <version>1.0.0</version>
  <packaging>hpi</packaging>
  <name>Agent Events</name>
  <description>Records build and executor events in SQLite and streams them over HTTP, resumable by sequence number.</description>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <properties>
    <!-- Two LTS lines below ci-sandbox (2.568.2) so the plugin is not pinned to
         the newest core; a plugin loads on any core at or above its baseline. -->
    <jenkins.version>2.528.1</jenkins.version>
    <!-- The one bundled library. Strict, so anything else being bundled fails
         the build instead of shipping unnoticed. -->
    <hpi.bundledArtifacts>sqlite-jdbc</hpi.bundledArtifacts>
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>
  </properties>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <!-- No plugin dependencies: everything else comes from Jenkins core. -->
  <dependencies>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.53.4.0</version>
      <exclusions>
        <!-- Jenkins core provides SLF4J; a second copy would shadow it. -->
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
</project>
